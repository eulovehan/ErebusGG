<Window x:Class="EternalGG.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EternalGG · Eternal Return Companion" Width="1160" Height="910" MaxWidth="1248" MaxHeight="1248" MinWidth="980" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#0B0F17" Foreground="#F3F5FA" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
  <Window.InputBindings>
    <KeyBinding Key="R" Modifiers="Control" Command="{Binding RecognizeCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding ToggleSettingsCommand}" />
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding LookupCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <SolidColorBrush x:Key="Muted" Color="#8793AA" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#1B2535" /><Setter Property="Foreground" Value="#D7DFEE" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="15,10" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D1420" /><Setter Property="Foreground" Value="#EDF3FC" /><Setter Property="CaretBrush" Value="#54E0BC" />
      <Setter Property="BorderBrush" Value="#2B3950" /><Setter Property="Padding" Value="10,8" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6DFED" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="174" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#101621" BorderBrush="#202A3A" BorderThickness="0,0,1,0">
      <Grid Margin="18,26,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border Background="#50DEB5" CornerRadius="8" Width="35" Height="35"><TextBlock Text="e" Foreground="#0B1816" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-4,0,0" /></Border><TextBlock Text="eternal" FontWeight="Bold" FontSize="23" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel>
          <TextBlock Text="YOUR MATCH COMPANION" Foreground="#5C6D86" FontSize="8" Margin="1,3,0,35" />
          <TextBlock Text="WORKSPACE" FontSize="9" Foreground="#5F6E86" Margin="10,0,0,12" />
          <Border Background="#17372F" CornerRadius="7" Padding="13,13"><TextBlock Text="◉   현재 매칭" Foreground="#62E3BF" FontWeight="SemiBold" /></Border>
          <Button Content="⌕   전적 검색" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,8,0,0" Click="SearchClick" />
          <Button Content="⚙   설정" Background="Transparent" Command="{Binding ToggleSettingsCommand}" />
          <Button Content="?   사용 가이드" Background="Transparent" Command="{Binding ToggleHelpCommand}" />
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Background="#171F2C" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="LOCAL FIRST" Foreground="#55D7B4" FontSize="10" FontWeight="Bold" /><TextBlock Text="화면 인식은 내 PC에서.&#10;전적은 공식 API로." Foreground="#93A0B6" FontSize="11" LineHeight="19" Margin="0,7,0,0" /></StackPanel></Border>
          <TextBlock Text="ETERNALGG  /  0.1.0" Foreground="#4F5C72" FontSize="9" Margin="6,18,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,25,28,24">
        <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="MATCH ROOM" FontSize="10" Foreground="#64758F" FontWeight="Bold" /><TextBlock Text="현재 매칭" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" /></StackPanel>
          <Border Grid.Column="1" Background="#142D29" CornerRadius="16" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="{Binding GameStatus}" Foreground="#62DEBB" FontSize="11" /></Border>
        </Grid>
        <Border CornerRadius="12" BorderBrush="#2A5148" BorderThickness="1" Padding="23,21" Margin="0,0,0,18">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#17362F" /><GradientStop Color="#111B2A" Offset="1" /></LinearGradientBrush></Border.Background>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding ModeLabel}" Foreground="#62DEBB" FontSize="11" Margin="0,0,0,9" /><TextBlock Text="{Binding PhaseTitle}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{Binding PhaseDetail}" Foreground="#9AABBC" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"><Button Content="이름 다시 읽기  ↗" Background="#54DFB7" Foreground="#092B22" FontWeight="Bold" Command="{Binding RecognizeCommand}" /><TextBlock Text="게임을 앞으로 가져오세요" Foreground="#7E9B94" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0" /></StackPanel>
          </Grid>
        </Border>
        <Border Background="#151D2C" CornerRadius="8" Padding="13,11" Margin="0,0,0,22"><DockPanel><Button DockPanel.Dock="Right" Content="API 설정" Command="{Binding ToggleSettingsCommand}" Padding="11,5" FontSize="11" /><TextBlock Text="{Binding ApiBanner}" Foreground="#A6B5CE" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" /></DockPanel></Border>
        <Grid Margin="0,0,0,12"><TextBlock Text="우리 팀" FontSize="17" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding PlayerCount}" Foreground="#57DEB8" FontWeight="Bold" Margin="0,0,12,0" /><TextBlock Text="닉네임을 눌러 수정할 수 있어요" Foreground="#6F7E96" FontSize="11" /></StackPanel></Grid>
        <ItemsControl ItemsSource="{Binding Players}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="#141C29" BorderBrush="#263246" BorderThickness="1" CornerRadius="11" Padding="17" Margin="0,0,10,0">
              <StackPanel>
                <DockPanel><Border Background="#20382F" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold" Foreground="#6BE1BC" /></Border><TextBlock Text="●" Foreground="#4E6078" HorizontalAlignment="Right" /></DockPanel>
                <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,7" ToolTip="화면에서 읽은 닉네임을 확인하거나 직접 입력하세요" MinHeight="42" />
                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#7285A0" Margin="0,0,0,18" />
                <TextBlock Text="RANKED MMR" FontSize="9" Foreground="#697E9B" /><TextBlock Text="{Binding Mmr}" FontSize="33" FontWeight="Light" Foreground="#EFF6FF" Margin="0,3,0,18" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="경기 수" Foreground="#71829B" FontSize="10" /><TextBlock Text="{Binding Games}" FontSize="19" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="승률" Foreground="#71829B" FontSize="10" /><TextBlock Text="{Binding WinRate}" FontSize="19" Margin="0,5,0,0" /></StackPanel></Grid>
                <Border Height="1" Background="#253043" Margin="0,18,0,13" />
                <DockPanel><TextBlock Text="평균 순위" FontSize="11" Foreground="#8293AC" /><TextBlock Text="{Binding AverageRank}" FontSize="13" HorizontalAlignment="Right" /></DockPanel>
                <TextBlock Text="{Binding Status}" Foreground="#C1AC79" FontSize="10" Margin="0,15,0,6" TextWrapping="Wrap" MinHeight="28" />
                <TextBlock Text="{Binding Recent}" Foreground="#6E809A" FontSize="10" TextWrapping="Wrap" MinHeight="30" />
              </StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,15,10,22"><Button DockPanel.Dock="Right" Content="전적 조회" Command="{Binding LookupCommand}" Background="#253A51" /><TextBlock Text="{Binding LastUpdated, StringFormat=마지막 조회  {0}}" Foreground="#64758D" FontSize="11" VerticalAlignment="Center" /></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
          <Border Background="#101824" CornerRadius="9" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="연결 상태" FontWeight="SemiBold" Margin="0,0,0,13" /><WrapPanel><TextBlock Text="로그  " Foreground="#6D809B" /><TextBlock Text="{Binding LogStatus}" Foreground="#ADC3DB" Margin="0,0,18,0" /><TextBlock Text="OCR  " Foreground="#6D809B" /><TextBlock Text="{Binding OcrStatus}" Foreground="#ADC3DB" /><TextBlock Text="  / API  " Foreground="#6D809B" /><TextBlock Text="{Binding ApiStatus}" Foreground="#ADC3DB" /></WrapPanel><ItemsControl ItemsSource="{Binding Events}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#647690" FontSize="10" Margin="0,3" TextTrimming="CharacterEllipsis" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Grid.Column="1" BorderBrush="#233044" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel VerticalAlignment="Center"><TextBlock Text="AD SPACE" Foreground="#485B76" FontSize="9" HorizontalAlignment="Center" /><TextBlock Text="플레이에 집중하세요." Foreground="#A5B4C9" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,8" /><TextBlock Text="광고 연동 준비 영역&#10;현재 광고가 재생되지 않습니다" Foreground="#556780" FontSize="10" TextAlignment="Center" LineHeight="18" /></StackPanel></Border>
        </Grid>
        <Border x:Name="SettingsPanel" Visibility="{Binding SettingsOpen, Converter={StaticResource Visible}}" Background="#151F2E" BorderBrush="#31455D" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,18,0,0">
          <StackPanel><TextBlock Text="연결 설정" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="본인 닉네임" Foreground="#8DA1BC" Margin="0,0,0,6" /><TextBox Text="{Binding SelfNickname, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="공식 API 키 (선택 / 이번 실행에만 보관)" Foreground="#8DA1BC" Margin="0,0,0,6" /><PasswordBox x:Name="ApiKeyBox" Background="#0D1420" Foreground="White" BorderBrush="#2B3950" Padding="10,8" PasswordChanged="ApiKeyChanged" /></StackPanel></Grid>
            <WrapPanel Margin="0,14,0,14"><TextBlock Text="시즌 ID" Foreground="#8DA1BC" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox Text="{Binding SeasonInput, UpdateSourceTrigger=PropertyChanged}" Width="75" /><CheckBox Content="랭크 전적 조회 (해제: 일반)" IsChecked="{Binding Ranked}" Margin="20,0,0,0" /><CheckBox Content="자동 이름 감지" IsChecked="{Binding AutoDetect}" Margin="20,0,0,0" /></WrapPanel>
            <TextBlock Text="게임 로그 경로" Foreground="#8DA1BC" Margin="0,0,0,6" /><TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
            <TextBlock Text="최근 OCR 진단 (이 PC에만 표시)" Foreground="#8DA1BC" Margin="0,12,0,6" /><TextBlock Text="{Binding OcrDiagnostic}" Foreground="#697E99" TextWrapping="Wrap" FontSize="11" />
            <TextBlock Text="{Binding SettingsMessage}" Foreground="#97B4A6" Margin="0,12" TextWrapping="Wrap" /><Button Content="설정 저장" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
        <Border Visibility="{Binding HelpOpen, Converter={StaticResource Visible}}" Background="#151F2E" CornerRadius="9" Padding="20" Margin="0,16,0,0"><StackPanel><TextBlock Text="처음 사용하시나요?" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="1. 게임을 실행하고 매칭을 시작하세요.&#10;2. 팀원 이름이 표시되는 동안 게임을 전경에 두세요.&#10;3. 이름이 틀리면 카드에서 직접 수정할 수 있어요.&#10;4. API 키가 없으면 이름 감지만 테스트하며 전적은 비워 둡니다.&#10;&#10;AI 대전은 본인 1명만 확인합니다. 인식 영역은 설정 파일에서 보정할 수 있습니다.&#10;게임 중 다시 읽기는 Tab 정보 화면에서 사용하세요.&#10;Ctrl+R 다시 읽기 / Ctrl+Enter 조회 / Ctrl+, 설정&#10;캡처 원본은 업로드하거나 저장하지 않습니다. 현재 버전에는 실제 광고가 없습니다." Foreground="#99ABC3" LineHeight="25" Margin="0,12,0,0" TextWrapping="Wrap" /></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
